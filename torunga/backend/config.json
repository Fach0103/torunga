    "invalidToken": "Token invalido o expirado",
    "onlyImages": "Solo se permiten archivos de imagen",
    "selfSwipeError": "No puedes interactuar contigo mismo",
    "targetNotFound": "Usuario objetivo no encontrado",
    "invalidDirection": "Direccion de swipe invalida",
    "notFriendsError": "Solo puedes enviar mensajes a tus amigos",
    "emptyMessageError": "El mensaje debe contener texto o una imagen",
    "noImageProvided": "No se proporciono ninguna imagen",
    "socketAuthRequired": "Autenticacion requerida en WebSocket",
